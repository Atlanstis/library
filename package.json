{
  "name": "obsidian-library",
  "version": "0.1.0",
  "private": true,
  "description": "通过 Obsidian 管理的个人知识库",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12.10.1"
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write \"**/*.md\"",
    "format:check": "prettier --check \"**/*.md\""
  },
  "lint-staged": {
    "*.md": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9"
  }
}
